{
  "name": "siteforge",
  "version": "1.0.0",
  "description": "A professional text-to-app and text-to-website builder application",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "build": "echo 'Building production bundle...'",
    "lint": "eslint src/**/*.js"
  },
  "keywords": [
    "text-to-app",
    "website-builder",
    "no-code",
    "ai-builder"
  ],
  "author": "SiteForge Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "eslint": "^8.54.0",
    "supertest": "^6.3.3"
  }
}
